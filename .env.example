# First startup creates .env with a random secret and this computer's addresses.
# Edit that generated file; do not copy this placeholder over its secret.
DJANGO_SECRET_KEY=replace-with-a-random-secret-of-at-least-50-characters
DJANGO_DEBUG=False
# Include the server's LAN IP and any hostname used by kiosks (no port numbers).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],192.168.1.10
# Set True only after configuring HTTPS. Local HTTP remains supported.
DJANGO_HTTPS=False
